+        prefill_counts[spec.group_index]++;
+      }
+
+      if (share_prompt_prefix)
+      {
+        for (const auto &active : active_groups)
+          llama_memory_seq_cp(memory, 0, active.prefix_sequence, 0, static_cast<llama_pos>(shared_prefix_length));
+      }
+
+      std::vector<decode_item> prompt_items;
+      for (const auto &active : active_groups)
+      {
+        const auto &prompt = groups[active.spec.group_index].prompt;
+        for (size_t index = shared_prefix_length; index < prompt.size(); index++)
+        {
+          output_action output;
+          if (index + 1 == prompt.size())
+          {
+            output.type = output_type::prefix;
+            output.group_index = active.spec.group_index;
+            output.candidate_start = active.spec.candidate_start;
+            output.candidate_end = active.spec.candidate_end;
+          }
+          prompt_items.push_back({prompt[index], static_cast<llama_pos>(index), active.prefix_sequence, output});
+        }
+      }
+      decode_items(prompt_items);
+
+      for (const auto &active : active_groups)
+      {
+        for (llama_seq_id sequence : active.candidate_sequences)
+        {
+          llama_memory_seq_cp(memory, active.prefix_sequence, sequence, -1, -1);
+        }
+      }
+
+      std::vector<decode_item> candidate_items;
+      for (const auto &active : active_groups)
+      {
+        const auto &group = groups[active.spec.group_index];
+        for (size_t offset = 0; offset < active.candidate_sequences.size(); offset++)
+        {
+          const size_t candidate_index = active.spec.candidate_start + offset;
+          const auto &target = group.targets[candidate_index];
+          for (size_t index = 0; index + 1 < target.size(); index++)
+          {
+            output_action output;
+            output.type = output_type::target;
+            output.group_index = active.spec.group_index;
+            output.candidate_index = candidate_index;
+            output.target = target[index + 1];
+            candidate_items.push_back({target[index], static_cast<llama_pos>(group.prompt.size() + index), active.candidate_sequences[offset], output});
+          }
+        }
+      }
+      decode_items(candidate_items);
+      if (share_prompt_prefix)
+      {
+        for (llama_seq_id sequence = 1; static_cast<size_t>(sequence) < max_sequences; sequence++)
+          llama_memory_seq_rm(memory, sequence, -1, -1);
+      }
+      else
+      {
+        llama_memory_clear(memory, true);
+      }
+    }
+
+    json group_results = json::array();
+    for (size_t group_index = 0; group_index < groups.size(); group_index++)
+    {
+      json scores = json::array();
+      for (size_t candidate_index = 0; candidate_index < groups[group_index].targets.size(); candidate_index++)
+      {
+        scores.push_back(json{
+            {"total_log_probability", accumulated[group_index][candidate_index]},
+            {"target_token_count", groups[group_index].targets[candidate_index].size()},
+        });
+      }
+      group_results.push_back(json{
+          {"scores", std::move(scores)},
+          {"prompt_token_count", groups[group_index].prompt.size()},
+          {"prefill_count", prefill_counts[group_index]},
+      });
+    }
+    return json{{"groups", std::move(group_results)}};
+  }
+
+  json score_known_texts(json body)
+  {
+    json groups = json::array();
+    groups.push_back(std::move(body));
+    return score_known_text_batch(json{{"groups", std::move(groups)}}).at("groups").at(0);
+  }
+
+  glue_msg_score_known_text_res action_score_known_text(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_score_known_text_req);
+    json body = json::parse(req.data_json.value);
+    if (!body.contains("target") || !body.at("target").is_string())
+    {
+      throw app_exception("\"target\" must be a string");
+    }
+    body["targets"] = json::array({body.at("target")});
+    body.erase("target");
+    const json result = score_known_texts(std::move(body));
+
+    glue_msg_score_known_text_res res;
+    res.success.value = true;
+    res.data_json.value = json{
+        {"total_log_probability", result.at("scores").at(0).at("total_log_probability")},
+        {"prompt_token_count", result.at("prompt_token_count")},
+        {"target_token_count", result.at("scores").at(0).at("target_token_count")},
+    }.dump();
+    return res;
+  }
+
+  glue_msg_score_known_texts_res action_score_known_texts(const char *req_raw)
+  {
+    PARSE_REQ(glue_msg_score_known_texts_req);
+    glue_msg_score_known_texts_res res;
+    res.success.value = true;
+    json body = json::parse(req.data_json.value);
+    res.data_json.value = (body.contains("groups") ? score_known_text_batch(std::move(body)) : score_known_texts(std::move(body))).dump();
+    return res;
+  }
