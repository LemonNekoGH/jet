+  if (softmax == nullptr || softmax->iface != &known_text_sampler_interface)
+    return false;
+  auto *context = static_cast<known_text_sampler_context *>(softmax->ctx);
+  if (targets.size() % context->target_width != 0)
+    return false;
+  context->targets = targets;
+  return true;
